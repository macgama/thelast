# The Last : réglages Apache (copié en .htaccess à la mise en ligne)
# Toujours en HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pas de liste des fichiers d'un dossier
Options -Indexes

# Le fichier de suivi du déploiement n'a pas à être lu
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

# Protections de base du navigateur
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Les pages et réglages toujours à jour, les images gardées en cache
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
</IfModule>
